create table members (id uuid primary key default gen_random_uuid(), name text not null, role text, phone text, status text default 'Actif', created_at timestamptz default now());
create table meetings (id uuid primary key default gen_random_uuid(), title text not null, date date, time time, place text, notes text, status text default 'À venir', created_at timestamptz default now());
create table mail (id uuid primary key default gen_random_uuid(), title text not null, date date, type text, status text, notes text, created_at timestamptz default now());
create table tasks (id uuid primary key default gen_random_uuid(), title text not null, due date, owner text, status text default 'À faire', created_at timestamptz default now());
create table documents (id uuid primary key default gen_random_uuid(), title text not null, type text, date date, notes text, created_at timestamptz default now());

