function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function render(){document.getElementById("today").textContent=new Date().toLocaleDateString("fr-FR",{weekday:"long",day:"numeric",month:"long",year:"numeric"});stats();renderList("meetingList",db.meetings,"meeting");renderList("mailList",db.mail,"mail");renderList("taskList",db.tasks,"task");renderList("memberList",db.members,"member");renderList("docList",db.docs,"doc");renderCalendar();dash()}
function stats(){let s=[["Réunions",db.meetings.length],["Courriers à traiter",db.mail.filter(x=>x.status==="À traiter").length],["Tâches ouvertes",db.tasks.filter(x=>x.status!=="Terminée").length],["Membres",db.members.length]];document.getElementById("stats").innerHTML=s.map(x=>`<div class="stat"><b>${x[1]}</b><span>${x[0]}</span></div>`).join("")}
function dash(){document.getElementById("dashMeetings").innerHTML=(db.meetings.slice(0,3).map(x=>`<div class="item"><strong>${esc(x.title)}</strong><span class="meta">${esc(x.date)} · ${esc(x.time||"")} ${esc(x.place||"")}</span></div>`).join("")||'<div class="empty">Aucune réunion</div>');document.getElementById("dashTasks").innerHTML=(db.tasks.filter(x=>x.status!=="Terminée").slice(0,3).map(x=>`<div class="item"><strong>${esc(x.title)}</strong><span class="meta">${esc(x.owner||"")} · ${esc(x.due||"")} · ${esc(x.status)}</span></div>`).join("")||'<div class="empty">Aucune tâche</div>')}
function renderList(id,arr,type){let el=document.getElementById(id);if(!arr.length){el.innerHTML='<div class="empty">Aucun élément enregistré.</div>';return}el.innerHTML=arr.map(x=>{let meta=type==="meeting"?`${x.date} · ${x.time||""} · ${x.place||""}`:type==="mail"?`${x.date} · ${x.type} · ${x.status}`:type==="task"?`${x.owner||""} · échéance ${x.due||""} · ${x.status}`:type==="member"?`${x.role} · ${x.phone||"Téléphone non renseigné"} · ${x.status}`:`${x.type||"Document"} · ${x.date||""}`;return `<div class="item"><div><strong>${esc(x.title||x.name)}</strong></div><span class="meta">${esc(meta)}</span>${x.notes?`<span class="meta">${esc(x.notes)}</span>`:""}<div class="actions"><button class="ghost" onclick="editItem(${x.id},'${type}')">Modifier</button><button class="danger" onclick="removeItem(${x.id},'${type}')">Supprimer</button>${type==="meeting"?`<button class="ghost" onclick="printPV(${x.id})">Imprimer PV</button>`:""}</div></div>`}).join("")}
