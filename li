function saveForm(e){e.preventDefault();let d=Object.fromEntries(new FormData(e.target));let id=Number(e.target.dataset.id)||Date.now();let obj={...d,id};if(currentType==="member")obj.name=obj.title,delete obj.title;let key={meeting:"meetings",mail:"mail",task:"tasks",member:"members",doc:"docs"}[currentType];let i=db[key].findIndex(x=>x.id===id);if(i>=0)db[key][i]=obj;else db[key].unshift(obj);save();closeModal();toast("Enregistré")}
